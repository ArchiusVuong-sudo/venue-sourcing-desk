# Port for next start / next dev (bound to 127.0.0.1)
PORT=4108
# 1 = always use recorded fixtures (no login or key needed)
DEMO_REPLAY=0
# Model for live runs: claude-sonnet-5-5, claude-opus-5-5 or claude-haiku-5-5
AGENT_MODEL=claude-sonnet-5-5
# Optional: an Anthropic API key; otherwise the local Claude Code login is used
ANTHROPIC_API_KEY=
# Where PGlite keeps its data (memory:// for a throwaway database)
DATA_DIR=.data/pglite
# 1 = save every live run as a replay fixture
RECORD_FIXTURES=0
# Replay pacing: 1 = recorded pace, 0.4 = default, 0 = instant
REPLAY_SPEED=0.4
